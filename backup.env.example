# Settings for backup.sh. Copy to backup.env (never committed) and fill in; then `chmod 600 backup.env`.

# Cloudflare R2: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/workout-planner-backups
# R2 API token with Object Read & Write on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Encrypts the backups. Keep a copy outside the Pi (e.g. a password manager): without it, the
# backups can't be read. Or put it in a file and set RESTIC_PASSWORD_FILE instead.
RESTIC_PASSWORD=

# Optional: healthchecks.io ping URL, so you're emailed when a backup fails or doesn't run
HEALTHCHECK_URL=

# Optional: how many snapshots to keep (restic forget options)
# KEEP="--keep-daily 7 --keep-weekly 8 --keep-monthly 24"
